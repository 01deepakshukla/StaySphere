<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="alert alert-danger col-6 offset-3" role="alert">

        <h4 class="alert-heading">
            <%= locals.statusCode || 500 %>
        </h4>

        <p>
            <%= locals.message || "Something went wrong!" %>
        </p>

    </div>
</div>